# ─────────────────────────────────────────────────────────────────────────────
# NavNet — environment configuration
# Copy to .env and fill in values before starting the stack.
# ─────────────────────────────────────────────────────────────────────────────

# ── NavNet Registry ───────────────────────────────────────────────────────────
REGISTRY_URL=http://localhost:8080
REGISTRY_ADMIN_USER=admin@navnet.local
REGISTRY_ADMIN_PASSWORD=changeme

# Database password for NavNet Registry and PostgreSQL service
REGISTRY_DB_PASSWORD=changeme

# ── Platform 2 PostgreSQL database (separate DB on same instance) ─────────────
P2_DB_PASSWORD=changeme
POSTGRES_URL=postgresql+asyncpg://p2:changeme@localhost:5432/platform2

# ── FastAPI ───────────────────────────────────────────────────────────────────
FASTAPI_PORT=8000
SECRET_KEY=change-me-to-a-long-random-string

# ── LLM provider — switch with one value: claude | openai | ollama ────────────
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3
# Model IDs (defaults used if not set)
CLAUDE_MODEL=claude-sonnet-4-20250514
OPENAI_MODEL=gpt-4o

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPICS_BMS_HVAC=navnet.telemetry.bms.hvac
KAFKA_TOPICS_BMS_ENERGY=navnet.telemetry.bms.energy
KAFKA_TOPICS_BMS_OTHER=navnet.telemetry.bms.other
KAFKA_TOPICS_NMS_NETWORK=navnet.telemetry.nms.network
KAFKA_TOPICS_NMS_INFRA=navnet.telemetry.nms.infra

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=navnet_kb

# ── Anomaly detection ─────────────────────────────────────────────────────────
ANOMALY_SIGMA_THRESHOLD=3.4
ANOMALY_BASELINE_DAYS=30

# ── Predictive maintenance ────────────────────────────────────────────────────
LSTM_FAILURE_THRESHOLD=0.75
# Hour of day (UTC) to run LSTM batch job (0-23)
LSTM_BATCH_HOUR=2

# ── GNN cascade detection ─────────────────────────────────────────────────────
CASCADE_ALARM_COUNT=3
CASCADE_WINDOW_SECONDS=60
